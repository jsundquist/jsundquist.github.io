---
import { DATA } from "@/data/resume";

const year = new Date().getFullYear();
---

<footer class="relative z-10 max-w-2xl mx-auto px-6 pb-28">
  <div
    class="flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-border pt-6 text-sm text-muted-foreground"
  >
    <p>© {year} {DATA.name}</p>
    <ul class="flex items-center gap-4">
      <li>
        <a href="/rss.xml" class="hover:text-foreground transition-colors">RSS</a>
      </li>
    </ul>
  </div>
</footer>
