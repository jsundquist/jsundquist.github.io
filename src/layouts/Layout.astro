---
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const { title, description = 'Personal site — resume, about, and blog.' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<header class="site-header">
			<nav>
				<a class="brand" href="/">Jonathan Sundquist</a>
				<a href="/about">About</a>
				<a href="/resume">Resume</a>
				<a href="/blog">Blog</a>
			</nav>
		</header>
		<main class="page">
			<slot />
		</main>
		<footer class="site-footer">
			&copy; {new Date().getFullYear()} Jonathan Sundquist
		</footer>
	</body>
</html>
