---
import Layout from "@/layouts/Layout.astro";
import BlogList from "@/components/BlogList";
import { getCollection } from "astro:content";
import { paginate, normalizePage } from "@/lib/pagination";
import { slugifyTag } from "@/lib/utils";

const PAGE_SIZE = 5;

export async function getStaticPaths() {
  const allPosts = await getCollection("blog");
  const tagSlugs = new Map<string, string>();
  for (const post of allPosts) {
    for (const tag of post.data.tags ?? []) {
      tagSlugs.set(slugifyTag(tag), tag);
    }
  }
  return Array.from(tagSlugs.entries()).map(([slug, tag]) => ({
    params: { tag: slug },
    props: { tag },
  }));
}

const { tag } = Astro.props;

const allPosts = await getCollection("blog");
const taggedPosts = allPosts.filter((post) =>
  post.data.tags?.some((t) => slugifyTag(t) === Astro.params.tag)
);
const sortedPosts = [...taggedPosts].sort((a, b) => {
  if (new Date(a.data.publishedAt) > new Date(b.data.publishedAt)) return -1;
  return 1;
});

const pageParam = Astro.url.searchParams.get("page") ?? undefined;
const totalPages = Math.ceil(sortedPosts.length / PAGE_SIZE);
const currentPage = normalizePage(pageParam, totalPages);
const { items: paginatedPosts, pagination } = paginate(sortedPosts, {
  page: currentPage,
  pageSize: PAGE_SIZE,
});

const posts = paginatedPosts.map((post) => ({
  id: post.id,
  title: post.data.title,
  publishedAt: post.data.publishedAt,
  tags: post.data.tags,
}));
---

<Layout
  title={`Blog — ${tag}`}
  description={`Posts tagged "${tag}".`}
>
  <BlogList
    client:load
    posts={posts}
    allPostsCount={sortedPosts.length}
    pagination={pagination}
    pageSize={PAGE_SIZE}
    activeTag={tag}
  />
</Layout>
